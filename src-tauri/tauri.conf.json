{
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "dessin_timer",
    "version": "0.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs":{
        "all": false,
        "readFile": true,
        "writeFile": true
      },
      "protocol": {
        "asset": true,
        "assetScope": [ "**" ]
      },
      "dialog": {
        "all": true,
        "ask": true, 
        "confirm": true,
        "message": true,
        "open": true
      },
      "shell": {
        "all": false,
        "open": true
      }
    },
    
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "dessintimer-app",
      "icon": [
        "icons/64x64.ico",
        "icons/512x512.ico"
      ]
    },

    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "dessin_timer",
        "width": 800,
        "height": 600
      }
    ]
  }
}
